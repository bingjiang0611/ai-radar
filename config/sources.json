      "id": "hf-weekly-papers",
      "source_label": "Hugging Face 本周热点",
      "category": "论文",
      "parser": "json_api",
      "url": "https://huggingface.co/api/daily_papers?week={week}",
      "enabled": true,
      "limit": 10,
      "json": {
        "items_path": "",
        "title": "paper.title",
        "url_template": "https://huggingface.co/papers/{paper.id}",
        "summary_template": "{paper.upvotes} upvotes",
        "content": "paper.summary"
      },
      "_note": "?week={week} 自动取当前 ISO 周(由 resolve_url 替换),返回该周 upvotes top 50;每日榜用 https://huggingface.co/api/daily_papers",
      "description": "Hugging Face 社区本周热门论文"
